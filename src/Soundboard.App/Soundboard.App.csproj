<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soundboard.App</RootNamespace>
    <AssemblyName>Soundboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Generated by tools/AssetGen from Assets/Logo.xaml; regenerate after changing the logo. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundboard.Core\Soundboard.Core.csproj" />
  </ItemGroup>

</Project>
